AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
CORS_ORIGINS=http://localhost:5173
# Per-role models (default to BEDROCK_MODEL_ID). Small/cheap models suit the reviewer and writer.
# REVIEWER_MODEL_ID=amazon.nova-lite-v1:0
# DECIDER_MODEL_ID=amazon.nova-pro-v1:0
# WRITER_MODEL_ID=amazon.nova-lite-v1:0
DECIDER_THRESHOLD=0.9              # below this confidence the request goes to a human
DECIDER_REVIEW_CLAIMS=false        # extra LLM claim audit before the deterministic guard (adds one model call)
SCHEDULING_WRITES_ENABLED=false    # demo is dry-run: no booking is ever performed
